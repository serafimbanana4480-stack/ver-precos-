# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Virtual env ──
.venv/
venv/
env/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Environment ──
.env
!.env.example

# ── Database ──
*.db-journal
*.db-wal
*.db-shm

# ── Logs ──
logs/
*.log

# ── Cache ──
catboost_info/
ml_outputs/

# ── Exports / Downloads ──
exports/*
!exports/.gitkeep
downloaded_files/

# ── Docker ──
docker-compose.override.yml

# ── Data (large files) ──
data/*.db
!data/.gitkeep

# ── Models (large binaries) ──
models/*.cbm
models/*.joblib

# ── Temporary / Scratch ──
scratch/
tmp/
temp/

