"""
Final mass scraper - uses all available OLX API categories + deep pagination
"""
from __future__ import annotations
import sys
import asyncio
import logging
import re
from typing import List, Dict, Any
from datetime import datetime, timezone

sys.path.insert(0, '.')

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)
for noisy in ['httpx']:
    logging.getLogger(noisy).setLevel(logging.WARNING)


async def fetch_olx_api(client, category_id: int, page: int, limit: int = 40) -> List[Dict[str, Any]]:
    """Fetch a single page from OLX API."""
    import httpx
    
    url = "https://www.olx.pt/api/v1/offers/"
    params = {
        "offset": (page - 1) * limit,
        "limit": limit,
        "category_id": category_id,
        "sort_by": "created_at:desc",
        "filter_refiners": "spell_checker",
    }
    
    headers = {
        "User-Agent": "OLX/6.70.0 (Android; Android 14; pt-PT)",
        "Accept": "application/json",
        "X-OLX-App-Version": "6.70.0",
        "X-OLX-Platform": "android",
    }
    
    try:
        response = await client.get(url, params=params, headers=headers, timeout=30)
        if response.status_code != 200:
            return []
        
        data = response.json()
        
        if isinstance(data, dict):
            data_content = data.get("data", [])
            if isinstance(data_content, list):
                offers = data_content
            else:
                offers = data_content.get("offers", []) if isinstance(data_content, dict) else []
        elif isinstance(data, list):
            offers = data
        else:
            return []
        
        listings = []
        for offer in offers:
            try:
                price = None
                for param in offer.get("params", []):
                    if param.get("key") == "price":
                        val = param.get("value", {})
                        if isinstance(val, dict):
                            price = float(val.get("value", 0))
                        break
                
                year = None
                for param in offer.get("params", []):
                    if param.get("key") == "year":
                        try:
                            year = int(param.get("value", {}).get("value", 0))
                        except:
                            pass
                        break
                
                km = None
                for param in offer.get("params", []):
                    if param.get("key") == "mileage":
                        try:
                            km = int(param.get("value", {}).get("value", 0))
                        except:
                            pass
                        break
                
                fuel = ""
                for param in offer.get("params", []):
                    if param.get("key") == "fuel_type":
                        fuel = str(param.get("value", {}).get("value", "")).lower()
                        break
                
                loc = offer.get("location", {})
                location = ""
                if isinstance(loc, dict):
                    city = loc.get("city", {}).get("name", "") if isinstance(loc.get("city"), dict) else str(loc.get("city", ""))
                    region = loc.get("region", {}).get("name", "") if isinstance(loc.get("region"), dict) else str(loc.get("region", ""))
                    location = f"{city}, {region}".strip(", ")
                else:
                    location = str(loc)
                
                photos = offer.get("photos", [])
                images = [p.get("url", "") for p in photos if isinstance(p, dict) and p.get("url")]
                
                title = str(offer.get("title", ""))
                
                if year is None:
                    year_match = re.search(r'\b(19[5-9]\d|20[0-3]\d)\b', title)
                    year = int(year_match.group(1)) if year_match else 2020
                
                brand, model = _parse_brand_model(title)
                
                listing_url = offer.get("url", "")
                if listing_url and not listing_url.startswith("http"):
                    listing_url = "https://www.olx.pt" + listing_url
                
                if not listing_url or not price:
                    continue
                
                # Determine vehicle type from category or title
                vtype = "carros"
                if category_id == 379 or category_id == 881 or any(m in title.lower() for m in ['ducati', 'yamaha', 'kawasaki', 'honda moto', 'suzuki moto', 'bmw moto', 'ktm', 'triumph']):
                    vtype = "motos"
                
                listings.append({
                    "source": "olx",
                    "source_id": str(offer.get("id", "")),
                    "url": listing_url,
                    "title": title,
                    "brand": brand,
                    "model": model,
                    "price": price,
                    "year": year,
                    "km": km,
                    "location": location,
                    "images": images,
                    "fuel_type": fuel,
                    "description": str(offer.get("description", ""))[:2000],
                    "vehicle_type": vtype,
                })
            except Exception:
                continue
        
        return listings
    except Exception:
        return []


def _parse_brand_model(title: str) -> tuple[str, str]:
    brands = [
        "Alfa Romeo", "Aston Martin", "Land Rover", "Mercedes-Benz", "Mercedes Benz",
        "Volkswagen", "BMW", "Mercedes", "Audi", "Renault", "Peugeot",
        "Citroën", "Citroen", "Ford", "Toyota", "Honda", "Nissan",
        "Hyundai", "Kia", "Fiat", "Seat", "Skoda", "Volvo",
        "Mazda", "Mitsubishi", "Suzuki", "Dacia", "Opel", "Mini",
        "Smart", "Jeep", "Subaru", "Tesla", "Jaguar", "Lexus",
        "Porsche", "Ducati", "Yamaha", "Kawasaki", "Triumph", "KTM",
        "CF Moto", "Royal Enfield", "Harley-Davidson", "Harley Davidson",
        "Aprilia", "Husqvarna", "Indian", "Moto Guzzi", "MV Agusta",
        "Benelli", "Beta", "Gas Gas", "GasGas", "SYM", "Kymco",
        "Piaggio", "Vespa", "Gilera", "Derbi", "SWM", "Voge", "Zontes",
        "NIU", "Super Soco", "Brixton", "Fantic", "Rieju",
    ]
    title_lower = title.lower()
    for brand in brands:
        if brand.lower() in title_lower:
            idx = title_lower.index(brand.lower())
            return brand, title[idx + len(brand):].strip()
    parts = title.split()
    if len(parts) >= 2:
        return parts[0], " ".join(parts[1:])
    return title, ""


async def save_batch(listings: List[Dict[str, Any]]) -> tuple[int, int]:
    from database.db import get_db_context
    from database.models import Vehicle, Source, VehicleType as VT, FuelType
    
    saved = 0
    updated = 0
    
    seen_urls = set()
    unique_listings = []
    for listing in listings:
        url = listing.get("url")
        if url and url not in seen_urls:
            seen_urls.add(url)
            unique_listings.append(listing)
    
    with get_db_context() as db:
        for listing in unique_listings:
            try:
                url = listing.get("url")
                if not url:
                    continue
                
                existing = db.query(Vehicle).filter(Vehicle.url == url).first()
                
                vtype = VT.carros if listing.get("vehicle_type") == "carros" else VT.motos
                
                if existing:
                    existing.price = listing.get("price")
                    existing.last_seen = datetime.now(timezone.utc)
                    updated += 1
                else:
                    vehicle = Vehicle(
                        source=Source.OLX,
                        source_id=listing.get("source_id", "")[:100],
                        url=url[:500],
                        vehicle_type=vtype,
                        brand=listing.get("brand", "Unknown")[:50],
                        model=listing.get("model", "")[:50],
                        title=listing.get("title", "")[:200],
                        price=listing.get("price"),
                        year=listing.get("year", 2020),
                        km=listing.get("km"),
                        location=str(listing.get("location", ""))[:100] if listing.get("location") else None,
                        images=listing.get("images", [])[:10],
                        description=listing.get("description", ""),
                        is_active=True,
                    )
                    
                    fuel = listing.get("fuel_type", "").lower()
                    if "gasolina" in fuel:
                        vehicle.fuel_type = FuelType.GASOLINE
                    elif "diesel" in fuel:
                        vehicle.fuel_type = FuelType.DIESEL
                    elif "eletrico" in fuel or "eléctrico" in fuel:
                        vehicle.fuel_type = FuelType.ELECTRIC
                    elif "hibrido" in fuel or "híbrido" in fuel:
                        vehicle.fuel_type = FuelType.HYBRID
                    elif "gpl" in fuel:
                        vehicle.fuel_type = FuelType.GPL
                    
                    db.add(vehicle)
                    saved += 1
            except Exception:
                continue
        
        try:
            db.commit()
        except Exception:
            db.rollback()
    
    return saved, updated


async def get_count() -> int:
    from database.db import get_db_context
    from database.models import Vehicle
    with get_db_context() as db:
        return db.query(Vehicle).count()


async def main():
    import httpx
    
    target = 5000
    current = await get_count()
    logger.info(f"TARGET: {target} | CURRENT: {current}")
    
    if current >= target:
        logger.info("Already reached target!")
        return
    
    # All vehicle categories found on OLX PT
    categories = [378, 379, 801, 803, 805, 809, 815, 817, 819, 821, 823, 827, 829, 841, 843, 845, 849, 851, 855, 859, 867, 875, 881, 891, 895, 899, 905, 907, 909, 911, 915, 921, 923, 929, 931, 933, 941, 945, 947, 953, 955, 957, 959, 965, 967, 969, 971, 973, 979, 983, 985, 999]
    
    async with httpx.AsyncClient() as client:
        total_new = 0
        total_updated = 0
        
        for cat_id in categories:
            if current >= target:
                break
            
            logger.info(f"\n=== Category {cat_id} ===")
            
            # Fetch pages with semaphore to not overload
            semaphore = asyncio.Semaphore(5)
            
            async def fetch_page(page: int) -> List[Dict[str, Any]]:
                async with semaphore:
                    return await fetch_olx_api(client, cat_id, page)
            
            page = 1
            while current < target and page <= 50:
                # Fetch 5 pages at a time
                tasks = [fetch_page(p) for p in range(page, page + 5)]
                results = await asyncio.gather(*tasks)
                
                all_listings = []
                for listings in results:
                    all_listings.extend(listings)
                
                if not all_listings:
                    logger.info(f"No more listings at page {page}, moving to next category")
                    break
                
                s, u = await save_batch(all_listings)
                total_new += s
                total_updated += u
                current = await get_count()
                
                logger.info(f"Pages {page}-{page+4}: {s} new, {u} updated | DB: {current}/{target}")
                
                page += 5
                await asyncio.sleep(0.3)
    
    logger.info(f"\nFINAL: {current}/{target} | New: {total_new} | Updated: {total_updated}")


if __name__ == "__main__":
    asyncio.run(main())
