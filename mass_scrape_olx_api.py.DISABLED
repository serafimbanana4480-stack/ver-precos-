"""
Mass Scraper using OLX API only - Fastest approach
No Playwright needed, pure HTTP API calls.
"""
from __future__ import annotations
import sys
import asyncio
import logging
import re
from typing import List, Dict, Any
from datetime import datetime, timezone

sys.path.insert(0, '.')

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

# Silence noisy loggers
for noisy in ['utils.html_change_detector', 'utils.observability', 'httpx']:
    logging.getLogger(noisy).setLevel(logging.WARNING)


async def fetch_olx_api_page(client, vehicle_type: str, page: int, limit: int = 40) -> List[Dict[str, Any]]:
    """Fetch a single page from OLX API."""
    import httpx
    
    url = "https://www.olx.pt/api/v1/offers/"
    category_id = 379 if vehicle_type == "motos" else 378
    
    params = {
        "offset": (page - 1) * limit,
        "limit": limit,
        "category_id": category_id,
        "sort_by": "created_at:desc",
        "filter_refiners": "spell_checker",
    }
    
    headers = {
        "User-Agent": "OLX/6.70.0 (Android; Android 14; pt-PT)",
        "Accept": "application/json",
        "Accept-Language": "pt-PT,pt;q=0.9",
        "X-OLX-App-Version": "6.70.0",
        "X-OLX-Platform": "android",
    }
    
    try:
        response = await client.get(url, params=params, headers=headers, timeout=30)
        if response.status_code != 200:
            return []
        
        data = response.json()
        
        if isinstance(data, dict):
            data_content = data.get("data", [])
            if isinstance(data_content, list):
                offers = data_content
            else:
                offers = data_content.get("offers", []) if isinstance(data_content, dict) else []
        elif isinstance(data, list):
            offers = data
        else:
            return []
        
        listings = []
        for offer in offers:
            try:
                # Extract price from params
                price = None
                for param in offer.get("params", []):
                    if param.get("key") == "price":
                        val = param.get("value", {})
                        if isinstance(val, dict):
                            price = float(val.get("value", 0))
                        break
                
                # Extract year from params
                year = None
                for param in offer.get("params", []):
                    if param.get("key") == "year":
                        try:
                            year = int(param.get("value", {}).get("value", 0))
                        except (ValueError, TypeError, AttributeError):
                            pass
                        break
                
                # Extract km from params
                km = None
                for param in offer.get("params", []):
                    if param.get("key") == "mileage":
                        try:
                            km = int(param.get("value", {}).get("value", 0))
                        except (ValueError, TypeError, AttributeError):
                            pass
                        break
                
                # Extract fuel from params
                fuel = ""
                for param in offer.get("params", []):
                    if param.get("key") == "fuel_type":
                        fuel = str(param.get("value", {}).get("value", "")).lower()
                        break
                
                # Location
                loc = offer.get("location", {})
                location = ""
                if isinstance(loc, dict):
                    city = loc.get("city", {}).get("name", "") if isinstance(loc.get("city"), dict) else str(loc.get("city", ""))
                    region = loc.get("region", {}).get("name", "") if isinstance(loc.get("region"), dict) else str(loc.get("region", ""))
                    location = f"{city}, {region}".strip(", ")
                else:
                    location = str(loc)
                
                # Images
                photos = offer.get("photos", [])
                images = []
                for photo in photos:
                    if isinstance(photo, dict):
                        img_url = photo.get("url", "")
                        if img_url:
                            images.append(img_url)
                
                title = str(offer.get("title", ""))
                
                # Extract year from title if not found
                if year is None:
                    year_match = re.search(r'\b(19[5-9]\d|20[0-3]\d)\b', title)
                    if year_match:
                        year = int(year_match.group(1))
                    else:
                        year = 2020  # Default
                
                # Parse brand/model
                brand, model = _parse_brand_model(title)
                
                listing_url = offer.get("url", "")
                if listing_url and not listing_url.startswith("http"):
                    listing_url = "https://www.olx.pt" + listing_url
                
                if not listing_url or not price:
                    continue
                
                listings.append({
                    "source": "olx",
                    "source_id": str(offer.get("id", "")),
                    "url": listing_url,
                    "title": title,
                    "brand": brand,
                    "model": model,
                    "price": price,
                    "year": year,
                    "km": km,
                    "location": location,
                    "images": images,
                    "fuel_type": fuel,
                    "description": str(offer.get("description", ""))[:2000],
                })
            except Exception as e:
                continue
        
        return listings
    except Exception as e:
        logger.warning(f"Page {page} error: {e}")
        return []


def _parse_brand_model(title: str) -> tuple[str, str]:
    brands = [
        "Alfa Romeo", "Aston Martin", "Land Rover", "Mercedes-Benz", "Mercedes Benz",
        "Volkswagen", "BMW", "Mercedes", "Audi", "Renault", "Peugeot",
        "Citroën", "Citroen", "Ford", "Toyota", "Honda", "Nissan",
        "Hyundai", "Kia", "Fiat", "Seat", "Skoda", "Volvo",
        "Mazda", "Mitsubishi", "Suzuki", "Dacia", "Opel", "Mini",
        "Smart", "Jeep", "Subaru", "Tesla", "Jaguar", "Lexus",
        "Porsche", "Ferrari", "Lamborghini", "Maserati", "Bentley",
        "Ducati", "Yamaha", "Kawasaki", "Triumph", "KTM", "Aprilia",
        "Husqvarna", "Indian", "Moto Guzzi", "MV Agusta", "Benelli",
        "Beta", "Gas Gas", "GasGas", "SYM", "Kymco", "Piaggio",
        "Vespa", "Gilera", "Derbi", "SWM", "Voge", "Zontes",
        "CF Moto", "Royal Enfield", "Harley-Davidson", "Harley Davidson",
        "NIU", "Super Soco", "Brixton", "Fantic", "Rieju",
    ]
    
    title_lower = title.lower()
    for brand in brands:
        if brand.lower() in title_lower:
            idx = title_lower.index(brand.lower())
            model = title[idx + len(brand):].strip()
            return brand, model
    
    parts = title.split()
    if len(parts) >= 2:
        return parts[0], " ".join(parts[1:])
    return title, ""


async def save_batch(listings: List[Dict[str, Any]], vehicle_type: str) -> tuple[int, int]:
    """Save listings to database."""
    from database.db import get_db_context
    from database.models import Vehicle, Source, VehicleType as VT, FuelType
    
    saved = 0
    updated = 0
    
    v_type = VT.carros if vehicle_type == "carros" else VT.motos
    
    # Deduplicate by URL within this batch
    seen_urls = set()
    unique_listings = []
    for listing in listings:
        url = listing.get("url")
        if url and url not in seen_urls:
            seen_urls.add(url)
            unique_listings.append(listing)
    
    with get_db_context() as db:
        for listing in unique_listings:
            try:
                url = listing.get("url")
                if not url:
                    continue
                
                existing = db.query(Vehicle).filter(Vehicle.url == url).first()
                
                if existing:
                    existing.price = listing.get("price")
                    existing.last_seen = datetime.now(timezone.utc)
                    updated += 1
                else:
                    vehicle = Vehicle(
                        source=Source.OLX,
                        source_id=listing.get("source_id", "")[:100],
                        url=url[:500],
                        vehicle_type=v_type,
                        brand=listing.get("brand", "Unknown")[:50],
                        model=listing.get("model", "")[:50],
                        title=listing.get("title", "")[:200],
                        price=listing.get("price"),
                        year=listing.get("year", 2020),
                        km=listing.get("km"),
                        location=str(listing.get("location", ""))[:100] if listing.get("location") else None,
                        images=listing.get("images", [])[:10],
                        description=listing.get("description", ""),
                        is_active=True,
                    )
                    
                    fuel = listing.get("fuel_type", "").lower()
                    if "gasolina" in fuel:
                        vehicle.fuel_type = FuelType.GASOLINE
                    elif "diesel" in fuel:
                        vehicle.fuel_type = FuelType.DIESEL
                    elif "eletrico" in fuel or "eléctrico" in fuel:
                        vehicle.fuel_type = FuelType.ELECTRIC
                    elif "hibrido" in fuel or "híbrido" in fuel:
                        vehicle.fuel_type = FuelType.HYBRID
                    elif "gpl" in fuel:
                        vehicle.fuel_type = FuelType.GPL
                    
                    db.add(vehicle)
                    saved += 1
            except Exception as e:
                logger.debug(f"Save error: {e}")
                continue
        
        try:
            db.commit()
        except Exception as e:
            logger.warning(f"Commit failed: {e}")
            db.rollback()
    
    return saved, updated


async def get_count() -> int:
    from database.db import get_db_context
    from database.models import Vehicle
    with get_db_context() as db:
        return db.query(Vehicle).count()


async def main():
    import httpx
    
    target = 5000
    current = await get_count()
    logger.info(f"TARGET: {target} | CURRENT: {current}")
    
    if current >= target:
        logger.info("Already reached target!")
        return
    
    async with httpx.AsyncClient() as client:
        page = 1
        total_new = 0
        total_updated = 0
        
        while current < target:
            # Fetch carros and motos pages concurrently
            car_tasks = [fetch_olx_api_page(client, "carros", p, 40) for p in range(page, page + 10)]
            moto_tasks = [fetch_olx_api_page(client, "motos", p, 40) for p in range(page, page + 5)]
            
            all_results = await asyncio.gather(*(car_tasks + moto_tasks))
            
            all_listings = []
            for listings in all_results:
                all_listings.extend(listings)
            
            if not all_listings:
                logger.warning("No listings fetched, trying next batch...")
                page += 10
                if page > 200:
                    logger.warning("Reached page limit, stopping")
                    break
                continue
            
            # Save to database
            car_listings = [l for l in all_listings if "carros" in l.get("url", "") or l.get("km", 0) is not None]
            moto_listings = [l for l in all_listings if l not in car_listings]
            
            s1, u1 = await save_batch(car_listings, "carros")
            s2, u2 = await save_batch(moto_listings, "motos")
            
            total_new += s1 + s2
            total_updated += u1 + u2
            
            current = await get_count()
            logger.info(f"Page {page}-{page+9}: Saved {s1+s2} new, {u1+u2} updated | TOTAL DB: {current}/{target}")
            
            page += 10
            
            # Small delay to be respectful
            await asyncio.sleep(0.5)
    
    logger.info(f"FINAL: {current}/{target} | New: {total_new} | Updated: {total_updated}")


if __name__ == "__main__":
    asyncio.run(main())
