# Database Configuration
DATABASE_URL=postgresql://autodeal:autodeal_password@localhost:5432/autodeal
POSTGRES_USER=autodeal
POSTGRES_PASSWORD=autodeal_password
POSTGRES_DB=autodeal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI Configuration
GROK_API_KEY=your_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1
OLLAMA_URL=http://localhost:11434
USE_OLLAMA=false
LLM_MODEL=grok-2-vision
VISION_MODEL=grok-2-vision

# Scraping Configuration
SCRAPING_INTERVAL_HOURS=6
MAX_LISTINGS_PER_SOURCE=100
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=3

# Deal Scoring
MIN_PROFIT_MARGIN_EUR=1500.0
MAX_PROFIT_MARGIN_PERCENT=25.0
DEAL_SCORE_THRESHOLD=7.0
TOP_DEALS_COUNT=20
AI_REVIEW_COUNT=50

# ML Configuration
MIN_TRAINING_SAMPLES=100

# Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient1@email.com,recipient2@email.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_TIMEZONE=Europe/Lisbon
DAILY_SCRAPING_TIME=08:00

# OLX Tracker (Rust)
OLX_TRACKER_PATH=./olx-tracker/target/release/olx-tracker

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Proxy (optional)
USE_PROXY=false
PROXY_URL=

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Validation Configuration
VALIDATION_STRICT_MODE=false
VALIDATION_FAILURE_THRESHOLD=10
VALIDATION_ALERT_ENABLED=true
