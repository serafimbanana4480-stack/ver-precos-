"""
AutoDeal IA Hunter - Overnight Runner
Executa scrapers + treino ML + valorização continuamente até às 08:00
"""
from __future__ import annotations
import sys
import asyncio
import logging
import json
import time
from pathlib import Path
from datetime import datetime, timezone, timedelta

sys.path.insert(0, str(Path(__file__).parent))

# ── configuração de logging ─────────────────────────────────────────────────
LOG_FILE = Path("logs/overnight_runner.log")
LOG_FILE.parent.mkdir(exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s - %(message)s",
    handlers=[
        logging.StreamHandler(sys.stdout),
        logging.FileHandler(LOG_FILE, encoding="utf-8"),
    ],
)
logger = logging.getLogger("overnight")

# ── constantes ──────────────────────────────────────────────────────────────
STOP_HOUR   = 8           # parar às 08:00 hora local
STOP_MINUTE = 0
MAX_PER_SOURCE = 100      # listings por fonte por ciclo
TRAIN_EVERY_N  = 2        # treinar modelo a cada N ciclos de scraping
VALUATE_EVERY_N = 1       # atualizar valorações a cada ciclo

SOURCES = ["olx", "standvirtual", "autosapo", "custojusto", "piscapisca", "carplus", "autopt"]
VEHICLE_TYPES = ["carros", "motos"]


def _stop_time_today() -> datetime:
    """Retorna o próximo instante 08:00 hora local (fuso UTC+1)."""
    from datetime import timezone, timedelta
    tz_local = timezone(timedelta(hours=1))
    now_local = datetime.now(tz_local)
    stop = now_local.replace(hour=STOP_HOUR, minute=STOP_MINUTE, second=0, microsecond=0)
    if stop <= now_local:
        stop += timedelta(days=1)
    return stop


def _seconds_until_stop(stop: datetime) -> float:
    from datetime import timezone, timedelta
    tz_local = timezone(timedelta(hours=1))
    remaining = (stop - datetime.now(tz_local)).total_seconds()
    return max(0.0, remaining)


def _format_duration(seconds: float) -> str:
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    return f"{h}h{m:02d}m"


# ── helpers ─────────────────────────────────────────────────────────────────
async def run_scrapers(cycle: int) -> dict:
    """Corre todos os scrapers em paralelo e guarda na BD."""
    from scrapers import (
        OLXScraper, StandvirtualScraper, AutoSapoScraper,
        CustoJustoScraper, PiscaPiscaScraper, CarplusScraper, AutoPtScraper,
    )
    from scrapers.browser_pool import get_browser_pool
    from processing.pipeline import production_pipeline

    logger.info(f"[CYCLE {cycle}] ══ Iniciando scraping de {len(SOURCES)} fontes × {len(VEHICLE_TYPES)} tipos ══")

    pool = get_browser_pool()
    scrapers_map = {
        "olx":          OLXScraper(),
        "standvirtual": StandvirtualScraper(),
        "autosapo":     AutoSapoScraper(),
        "custojusto":   CustoJustoScraper(),
        "piscapisca":   PiscaPiscaScraper(),
        "carplus":      CarplusScraper(),
        "autopt":       AutoPtScraper(),
    }

    async def _scrape_one(name: str, scraper, vtype: str):
        t0 = time.monotonic()
        try:
            listings = await scraper.scrape_listings(
                vtype,
                max_listings=MAX_PER_SOURCE,
                scrape_details=False,
            )
            elapsed = time.monotonic() - t0
            count = len(listings) if listings else 0
            logger.info(f"[CYCLE {cycle}] {name}/{vtype}: {count} listings em {elapsed:.1f}s")
            return listings or []
        except Exception as exc:
            elapsed = time.monotonic() - t0
            logger.error(f"[CYCLE {cycle}] {name}/{vtype} FALHOU após {elapsed:.1f}s: {exc}")
            return []

    tasks = [
        _scrape_one(name, scraper, vtype)
        for name, scraper in scrapers_map.items()
        for vtype in VEHICLE_TYPES
    ]

    t_start = time.monotonic()
    results = await asyncio.gather(*tasks, return_exceptions=True)
    t_total = time.monotonic() - t_start

    all_listings = []
    for r in results:
        if isinstance(r, list):
            all_listings.extend(r)
        elif isinstance(r, Exception):
            logger.error(f"[CYCLE {cycle}] Exceção no gather: {r}")

    logger.info(f"[CYCLE {cycle}] Scraping concluído: {len(all_listings)} listings em {t_total:.1f}s")

    # Fechar browser pool
    try:
        await pool.close_all()
    except Exception:
        pass

    # Pipeline de processamento
    if all_listings:
        try:
            pipeline_result = production_pipeline.process_batch(all_listings)
            logger.info(
                f"[CYCLE {cycle}] Pipeline: total={pipeline_result['total']} "
                f"ok={pipeline_result['success']} erros={pipeline_result['error']} "
                f"score_médio={pipeline_result.get('avg_score', 0):.2f}/10"
            )
            return {
                "total": pipeline_result["total"],
                "success": pipeline_result["success"],
                "avg_score": pipeline_result.get("avg_score", 0),
                "duration": t_total,
            }
        except Exception as exc:
            logger.error(f"[CYCLE {cycle}] Pipeline falhou: {exc}")

    return {"total": len(all_listings), "success": 0, "avg_score": 0, "duration": t_total}


def run_train(cycle: int, force: bool = False) -> bool:
    """Treina/atualiza o modelo ML com os dados acumulados."""
    logger.info(f"[CYCLE {cycle}] ── Treino do modelo ML ──")
    try:
        from valuation.enhanced_train import train_enhanced_models
        pricing = train_enhanced_models(force_retrain=force)
        if pricing.car_model or pricing.moto_model:
            car_r2  = (pricing.car_metrics  or {}).get("r2",  "N/A")
            moto_r2 = (pricing.moto_metrics or {}).get("r2", "N/A")
            car_n   = (pricing.car_metrics  or {}).get("n_samples", 0)
            moto_n  = (pricing.moto_metrics or {}).get("n_samples", 0)
            logger.info(
                f"[CYCLE {cycle}] Modelo treinado! "
                f"Cars: R²={car_r2} (n={car_n}) | Motos: R²={moto_r2} (n={moto_n})"
            )
            return True
        else:
            logger.warning(f"[CYCLE {cycle}] Treino não produziu modelo (dados insuficientes?)")
            return False
    except Exception as exc:
        logger.error(f"[CYCLE {cycle}] Treino falhou: {exc}")
        return False


def run_valuate(cycle: int) -> int:
    """Atualiza as valorações de todos os veículos na BD."""
    logger.info(f"[CYCLE {cycle}] ── Atualização de valorações ──")
    try:
        from valuation.predict import update_vehicle_valuations
        update_vehicle_valuations(batch_size=500)
        logger.info(f"[CYCLE {cycle}] Valorações atualizadas")
        return 1
    except Exception as exc:
        logger.error(f"[CYCLE {cycle}] Valoração falhou: {exc}")
        return 0


def run_find_deals(cycle: int) -> list:
    """Encontra os melhores negócios e regista no log."""
    try:
        from ai_agent.deal_finder import DealFinder
        finder = DealFinder()
        deals = finder.find_best_deals(limit=10, min_profit=None)
        if deals:
            top = deals[0]
            logger.info(
                f"[CYCLE {cycle}] 🏆 TOP DEAL: {top.get('brand')} {top.get('model')} "
                f"({top.get('year')}) €{top.get('price', 0):,.0f} | "
                f"score={top.get('deal_score', 0):.1f}/10 | "
                f"lucro=€{top.get('profit_potential', 0):,.0f}"
            )
        logger.info(f"[CYCLE {cycle}] {len(deals)} melhores negócios encontrados")
        return deals
    except Exception as exc:
        logger.error(f"[CYCLE {cycle}] Pesquisa de negócios falhou: {exc}")
        return []


def get_db_stats() -> dict:
    """Recolhe estatísticas da base de dados."""
    try:
        from database.db import get_db_context
        from database.models import Vehicle, ScrapingLog
        from sqlalchemy import func
        with get_db_context() as db:
            total = db.query(func.count(Vehicle.id)).scalar() or 0
            active = db.query(func.count(Vehicle.id)).filter(Vehicle.is_active == True).scalar() or 0  # noqa: E712
            scored = db.query(func.count(Vehicle.id)).filter(Vehicle.deal_score != None).scalar() or 0  # noqa: E711
            avg_score_row = db.query(func.avg(Vehicle.deal_score)).filter(Vehicle.deal_score != None).scalar()  # noqa: E711
            avg_score = float(avg_score_row) if avg_score_row else 0.0
            avg_price_row = db.query(func.avg(Vehicle.price)).filter(Vehicle.price != None).scalar()  # noqa: E711
            avg_price = float(avg_price_row) if avg_price_row else 0.0
        return {
            "total": total,
            "active": active,
            "scored": scored,
            "avg_score": avg_score,
            "avg_price": avg_price,
        }
    except Exception as exc:
        logger.error(f"Estatísticas BD falhou: {exc}")
        return {}


def print_banner(cycle: int, stop: datetime, stats: dict) -> None:
    from datetime import timezone, timedelta
    tz_local = timezone(timedelta(hours=1))
    now_str  = datetime.now(tz_local).strftime("%H:%M:%S")
    stop_str = stop.strftime("%H:%M")
    remaining = _seconds_until_stop(stop)
    rem_str  = _format_duration(remaining)

    logger.info("=" * 60)
    logger.info(f"  🚀 CICLO #{cycle}  |  {now_str}  |  Tempo restante: {rem_str} (até {stop_str})")
    logger.info(f"  📊 BD: {stats.get('total', 0):,} veículos total | {stats.get('active', 0):,} ativos")
    logger.info(f"  ⭐ Score médio: {stats.get('avg_score', 0):.2f}/10 | {stats.get('scored', 0):,} avaliados")
    logger.info(f"  💶 Preço médio: €{stats.get('avg_price', 0):,.0f}")
    logger.info("=" * 60)


# ── loop principal ───────────────────────────────────────────────────────────
async def main():
    from config import settings
    from utils.logging_config import setup_logging
    from utils.production_safeguards import setup_signal_handlers
    from database.db import init_db

    setup_signal_handlers()
    setup_logging()

    # Garantir que a BD está inicializada
    try:
        init_db()
        logger.info("Base de dados OK")
    except Exception as exc:
        logger.error(f"Erro ao inicializar BD: {exc}")
        sys.exit(1)

    stop_at  = _stop_time_today()
    from datetime import timezone, timedelta
    tz_local = timezone(timedelta(hours=1))
    logger.info(f"⏰ Overnight runner iniciado. Para às {stop_at.astimezone(tz_local).strftime('%H:%M')} (hora local).")
    logger.info(f"   Tempo total disponível: {_format_duration(_seconds_until_stop(stop_at))}")

    cycle      = 0
    total_new  = 0
    best_score = 0.0

    # ── JSON de progresso para acompanhamento ─────────────────────────────
    PROGRESS_FILE = Path("logs/overnight_progress.json")

    def save_progress(extra: dict = {}):
        data = {
            "cycle": cycle,
            "total_new": total_new,
            "best_avg_score": best_score,
            "stop_at": stop_at.isoformat(),
            "updated_at": datetime.now(timezone.utc).isoformat(),
            **extra,
        }
        PROGRESS_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

    save_progress()

    while _seconds_until_stop(stop_at) > 60:
        cycle += 1
        stats_before = get_db_stats()
        print_banner(cycle, stop_at, stats_before)

        # ── 1. SCRAPING ────────────────────────────────────────────────
        scrape_result = await run_scrapers(cycle)
        total_new += scrape_result.get("success", 0)

        # ── 2. TREINO ML (a cada N ciclos ou no primeiro) ──────────────
        if cycle % TRAIN_EVERY_N == 0 or cycle == 1:
            run_train(cycle, force=(cycle == 1))

        # ── 3. ATUALIZAR VALORAÇÕES ────────────────────────────────────
        if cycle % VALUATE_EVERY_N == 0:
            run_valuate(cycle)

        # ── 4. ENCONTRAR MELHORES NEGÓCIOS ────────────────────────────
        deals = run_find_deals(cycle)

        # ── 5. ESTATÍSTICAS APÓS CICLO ────────────────────────────────
        stats_after = get_db_stats()
        avg_score   = stats_after.get("avg_score", 0)
        if avg_score > best_score:
            best_score = avg_score
            logger.info(f"[CYCLE {cycle}] 📈 Novo melhor score médio: {best_score:.3f}/10")

        delta_vehicles = stats_after.get("total", 0) - stats_before.get("total", 0)
        logger.info(
            f"[CYCLE {cycle}] ✅ Concluído: +{delta_vehicles} veículos | "
            f"score médio: {avg_score:.3f}/10 | "
            f"total acumulado: {total_new} novos"
        )

        save_progress({
            "last_cycle_delta": delta_vehicles,
            "current_avg_score": avg_score,
            "deals_found": len(deals),
        })

        # ── pausa adaptativa entre ciclos ────────────────────────────
        remaining = _seconds_until_stop(stop_at)
        if remaining <= 60:
            logger.info("⏹  Menos de 60s restantes — a encerrar.")
            break

        # Pausa mínima entre ciclos: 60s (para não marteler as APIs)
        pause = min(60, remaining - 30)
        logger.info(f"[CYCLE {cycle}] 💤 Pausa de {pause:.0f}s antes do próximo ciclo...")
        await asyncio.sleep(pause)

    # ── Sumário final ───────────────────────────────────────────────────────
    final_stats = get_db_stats()
    logger.info("")
    logger.info("╔══════════════════════════════════════════════════════╗")
    logger.info("║          OVERNIGHT RUNNER — SUMÁRIO FINAL            ║")
    logger.info("╠══════════════════════════════════════════════════════╣")
    logger.info(f"║  Ciclos completos  : {cycle:<33}║")
    logger.info(f"║  Veículos na BD    : {final_stats.get('total', 0):<33,}║")
    logger.info(f"║  Veículos ativos   : {final_stats.get('active', 0):<33,}║")
    logger.info(f"║  Avaliados c/ score: {final_stats.get('scored', 0):<33,}║")
    logger.info(f"║  Score médio final : {final_stats.get('avg_score', 0):<33.3f}║")
    logger.info(f"║  Melhor score médio: {best_score:<33.3f}║")
    logger.info(f"║  Preço médio       : €{final_stats.get('avg_price', 0):<32,.0f}║")
    logger.info("╚══════════════════════════════════════════════════════╝")

    save_progress({
        "finished": True,
        "final_total": final_stats.get("total", 0),
        "final_avg_score": final_stats.get("avg_score", 0),
    })
    logger.info("🏁 Overnight runner terminado com sucesso.")


if __name__ == "__main__":
    asyncio.run(main())
